{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "user-cluster",
        "Match": { "Path": "/auth/{**catch-all}" }
      },
      "comics-route": {
        "ClusterId": "comic-cluster",
        "Match": { "Path": "/comics/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/comics/{**catch-all}" }
        ]
      },
      "categories-route": {
        "ClusterId": "comic-cluster",
        "Match": { "Path": "/categories/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/categories/{**catch-all}" }
        ]
      },
      "translations-route": {
        "ClusterId": "comic-cluster",
        "Match": { "Path": "/translations/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/translations/{**catch-all}" }
        ]
      },
      "chapters-route": {
        "ClusterId": "chapter-cluster",
        "Match": { "Path": "/chapters/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/chapters/{**catch-all}" }
        ]
      },
      "comments-route": {
        "ClusterId": "social-cluster",
        "Match": { "Path": "/comments/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/comments/{**catch-all}" }
        ]
      },
      "favorites-route": {
        "ClusterId": "social-cluster",
        "Match": { "Path": "/favorites/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/favorites/{**catch-all}" }
        ]
      },
      "follows-route": {
        "ClusterId": "social-cluster",
        "Match": { "Path": "/follows/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/follows/{**catch-all}" }
        ]
      },
      "reading-history-route": {
        "ClusterId": "social-cluster",
        "Match": { "Path": "/reading-history/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/reading-history/{**catch-all}" }
        ]
      },
      "payments-route": {
        "ClusterId": "payment-cluster",
        "Match": { "Path": "/payments/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/payments/{**catch-all}" }
        ]
      },
      "wallets-route": {
        "ClusterId": "wallet-cluster",
        "Match": { "Path": "/wallets/{**catch-all}" }
      },
      "currency-route": {
        "ClusterId": "wallet-cluster",
        "Match": { "Path": "/currency/{**catch-all}" }
      },
      "withdraws-route": {
        "ClusterId": "wallet-cluster",
        "Match": { "Path": "/withdraws/{**catch-all}" }
      },
      "banners-route": {
        "ClusterId": "banner-cluster",
        "Match": { "Path": "/banners/{**catch-all}" }
      },
      "uploads-route": {
        "ClusterId": "mission-cluster",
        "Match": { "Path": "/uploads/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/uploads/{**catch-all}" }
        ]
      },
      "missions-route": {
        "ClusterId": "mission-cluster",
        "Match": { "Path": "/missions/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/missions/{**catch-all}" }
        ]
      },
      "notifications-route": {
        "ClusterId": "mission-cluster",
        "Match": { "Path": "/notifications/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/notifications/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "user-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://127.0.0.1:5054" }
        }
      },
      "comic-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://127.0.0.1:5023" }
        }
      },
      "chapter-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://127.0.0.1:5115" }
        }
      },
      "social-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://127.0.0.1:5197" }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://127.0.0.1:5128" }
        }
      },
      "wallet-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://127.0.0.1:5091" }
        }
      },
      "mission-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://127.0.0.1:5288" }
        }
      },
      "banner-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://127.0.0.1:5127" }
        }
      }
    }
  }
}
